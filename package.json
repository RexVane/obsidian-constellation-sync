{
  "name": "obsidian-constellation-sync",
  "version": "0.6.1",
  "description": "Multi-device Obsidian vault synchronization through GitHub repository branches.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "release:check": "node scripts/validate-release.mjs",
    "check": "npm run release:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "obsidian",
    "github",
    "sync",
    "vault"
  ],
  "author": "Constellation Sync Contributors",
  "license": "MIT",
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^16.0.0",
    "obsidian": "1.13.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
